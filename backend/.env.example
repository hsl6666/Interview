ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/interviewer.db
PUBLIC_BASE_URL=http://192.168.1.10:8000
FRONTEND_ORIGIN=http://127.0.0.1:5173
ZHIPU_API_KEY=
GLM_MODEL=glm-4.6
INTERVIEW_MINUTES=30
WRITTEN_EXAM_MINUTES=30

# LINUX DO Connect: register this exact backend callback in the Connect app.
# Keep CLIENT_SECRET on the backend only. Comma-separated immutable numeric user IDs.
LINUXDO_CLIENT_ID=
LINUXDO_CLIENT_SECRET=
LINUXDO_REDIRECT_URI=http://127.0.0.1:8010/api/auth/linuxdo/callback
LINUXDO_ADMIN_IDS=
AUTH_SESSION_HOURS=12
