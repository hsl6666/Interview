# Copy this to scripts/deploy/backend.env if you want the deploy script to upload it.
# Or create the same file directly on the server at /opt/mianshi/backend.env.
# Do not commit a real backend.env.

ENVIRONMENT=production
DATABASE_URL=sqlite:///./data/interviewer.db
PUBLIC_BASE_URL=https://example.com
FRONTEND_ORIGIN=https://example.com
ZHIPU_API_KEY=
GLM_MODEL=glm-4.6
INTERVIEW_MINUTES=30
WRITTEN_EXAM_MINUTES=30

# Register the exact HTTPS callback in LINUX DO Connect; never commit real credentials.
LINUXDO_CLIENT_ID=
LINUXDO_CLIENT_SECRET=
LINUXDO_REDIRECT_URI=https://example.com/api/auth/linuxdo/callback
LINUXDO_ADMIN_IDS=
AUTH_SESSION_HOURS=12
